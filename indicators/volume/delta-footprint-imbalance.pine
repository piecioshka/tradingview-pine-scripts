//@version=6
indicator('Delta Footprint Imbalance', overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// Footprint imbalance (diagonal / stacked) from real request.footprint data (since January 2026).
// The footprint splits a candle into price levels and knows the aggressor volume on the buy (ask) and sell (bid) side.
//
// DIAGONAL IMBALANCE (a "diagonal" comparison, as in a classic footprint):
//   • Buy (ask):  BUY volume at level P  vs  SELL volume one level LOWER (P-1).
//   • Sell (bid): SELL volume at level P  vs  BUY volume one level HIGHER (P+1).
//   An imbalance occurs when the dominant side ≥ (ratio) × the opposite side (classically 3:1).
//
// STACKED IMBALANCE: N+ consecutive levels with an imbalance in the same direction (default 3).
//   Stacked buy imbalances  = zone of aggressive accumulation / potential SUPPORT (green).
//   Stacked sell imbalances = zone of aggressive distribution / potential RESISTANCE (red).
//
// ZONES (the main value): each stacked imbalance becomes an S/R zone drawn as a box extending
//   to the right UNTIL price tests it (mitigation). Once tested, the zone fades or disappears.
//   Zone strength (the number of stacked levels) drives its color intensity. A mini-dashboard counts
//   active zones and points to the nearest one above/below price.
//
// REQUIREMENTS / LIMITATIONS (imposed by TradingView):
//   • Premium or Ultimate account — without it the script does NOT compile.
//   • request.footprint() works only for the CURRENT timeframe, one call per script.
//   • Zones form only on CLOSED candles (no repaint) — a forming candle waits for its close.

// --- Default palette (TradingView candle colors) ---
cBuyDef  = color.rgb(38, 166, 154)  // buy imbalance — default candle green #26A69A
cSellDef = color.rgb(239, 83, 80)   // sell imbalance — default candle red #EF5350

// --- Stacked imbalance zone (S/R) ---
type Zone
    float top         // upper zone boundary (price)
    float bot         // lower zone boundary (price)
    int   dir         // 1 = buy (bull), -1 = sell (bear)
    int   strength    // number of stacked levels (strength)
    int   startBar    // bar_index where it formed
    bool  armed       // has price left the zone (mitigation test armed)
    bool  mitigated   // has the zone been tested
    box   bx
    label lb

// --- Footprint ---
gCalc = 'Footprint'
ticksPerRow = input.int(5, 'Ticks per row', minval=1, group=gCalc, tooltip='Footprint row height in ticks = imbalance level resolution. Fewer = finer levels (more sensitive imbalance), but more computation.')

// --- Imbalance ---
gImb = 'Imbalance'
ratio    = input.float(3.0, 'Imbalance ratio (X:1)', minval=1.0, step=0.1, group=gImb, tooltip='The dominant side must be ≥ X times larger than the opposite one (diagonally). Classically 3:1.')
minVol   = input.float(0.0, 'Min. level volume',     minval=0.0, group=gImb, tooltip='Ignore levels where the volume of the dominant side is below this value (noise filter). 0 = no filter.')
minStack = input.int(3, 'Min. stacked levels', minval=2, group=gImb, tooltip='How many consecutive levels with an imbalance in the same direction form a zone.')

// --- S/R zones ---
gZones = 'S/R zones'
showZones   = input.bool(true,  'Show stacked zones',      group=gZones, tooltip='Each stacked imbalance = a zone extending to the right until price tests it.')
mitUseClose = input.bool(true, 'Mitigation by close',      group=gZones, tooltip='A zone is "tested" when the CLOSE enters it. Off = the wick (high/low) counts — more sensitive.')
hideMitig   = input.bool(true, 'Hide zones after a test',  group=gZones, tooltip='Remove the zone as soon as it is tested. Off = the zone stays but fades (dashed border).')
tMitig      = input.int(92, 'Transparency after a test', minval=0, maxval=100, group=gZones, tooltip='How much to fade a zone after it is tested (when not hidden).')
maxZones    = input.int(25, 'Max. number of zones', minval=1, maxval=200, group=gZones, tooltip='Keep only the last N zones (older ones are removed). Protects against the chart object limit.')

// --- Strength as color ---
gStr = 'Strength as color'
tZoneWeak   = input.int(85, 'Transparency — weak zone',   minval=0, maxval=100, group=gStr, tooltip='Transparency of a zone with length = "Min. stacked levels" (the weakest).')
tZoneStrong = input.int(35, 'Transparency — strong zone', minval=0, maxval=100, group=gStr, tooltip='Transparency of a zone with length "Min. + 6" or more (the strongest). Lower = louder.')

// --- Display ---
gView = 'Display'
showCount  = input.bool(true,  'Level count in zone',      group=gView, tooltip='Label with the number of stacked levels (strength) next to the zone.')
showLevels = input.bool(false, 'Show single imbalances',   group=gView, tooltip='A mark on EVERY level with an imbalance (vertical dash on the candle axis). Off by default.')
markWidth  = input.int(6, 'Single mark width (px)', minval=1, maxval=30, group=gView, tooltip='Width of the vertical mark of a single imbalance (in pixels), centered on the candle.')
tLevels    = input.int(80, 'Single mark transparency', minval=0, maxval=100, group=gView)

// --- Mini-dashboard ---
gDash = 'Mini-dashboard'
showDash = input.bool(true, 'Show dashboard', group=gDash, tooltip='Table: number of active bull/bear zones + the nearest zone above and below price.')
dashPos  = input.string('Bottom right', 'Position', options=['Top left', 'Top right', 'Bottom left', 'Bottom right'], group=gDash)

// --- Colors ---
gColors = 'Colors'
cBuy  = input.color(cBuyDef,  'Buy imbalance (ask)',  group=gColors)
cSell = input.color(cSellDef, 'Sell imbalance (bid)', group=gColors)

// --- Current candle footprint ---
fp = request.footprint(ticksPerRow)
hasData = not na(fp)

// State: active and tested zones.
var array<Zone> zones = array.new<Zone>()

// Alert flags (set inside the loop, read by alertcondition in the global scope).
bool stackBuy  = false
bool stackSell = false

// Transparency by zone strength: minStack → weak, minStack+6 → strong.
f_zoneTransp(int s) =>
    f = math.min(1.0, math.max(0.0, (s - minStack) / 6.0))
    int(tZoneWeak + (tZoneStrong - tZoneWeak) * f)

if hasData and barstate.isconfirmed
    rows = fp.rows()
    n = array.size(rows)
    if n >= 2
        // --- Read the levels into arrays ---
        buyV  = array.new<float>()
        sellV = array.new<float>()
        pUp   = array.new<float>()
        pDn   = array.new<float>()
        for i = 0 to n - 1
            r = array.get(rows, i)
            array.push(buyV,  r.buy_volume())
            array.push(sellV, r.sell_volume())
            array.push(pUp,   r.up_price())
            array.push(pDn,   r.down_price())

        // Sort ascending by price (index 0 = the lowest level), regardless of the API order.
        if array.get(pDn, 0) > array.get(pDn, n - 1)
            array.reverse(buyV)
            array.reverse(sellV)
            array.reverse(pUp)
            array.reverse(pDn)

        // --- Imbalance direction at each level: 1 = buy, -1 = sell, 0 = none ---
        dir = array.new<int>(n, 0)
        for i = 0 to n - 1
            bv = array.get(buyV, i)
            sv = array.get(sellV, i)
            buyImb = false
            if i >= 1
                bvAgainst = array.get(sellV, i - 1)   // sell one level LOWER (the diagonal)
                buyImb := bv > 0 and bv >= minVol and bv >= ratio * bvAgainst
            sellImb = false
            if i <= n - 2
                svAgainst = array.get(buyV, i + 1)    // buy one level HIGHER (the diagonal)
                sellImb := sv > 0 and sv >= minVol and sv >= ratio * svAgainst
            d = 0
            if buyImb and sellImb
                d := bv >= sv ? 1 : -1                // rare tie — pick the stronger side
            else if buyImb
                d := 1
            else if sellImb
                d := -1
            array.set(dir, i, d)

        // --- Single levels with an imbalance (vertical mark on the candle axis) ---
        if showLevels
            for i = 0 to n - 1
                d = array.get(dir, i)
                if d != 0
                    col = d == 1 ? cBuy : cSell
                    line.new(bar_index, array.get(pUp, i), bar_index, array.get(pDn, i), xloc=xloc.bar_index, color=color.new(col, tLevels), width=markWidth)

        // --- Stacked zones: maximal same-direction runs ≥ minStack ---
        i = 0
        while i < n
            d = array.get(dir, i)
            if d != 0
                j = i
                while j + 1 < n and array.get(dir, j + 1) == d
                    j += 1
                runLen = j - i + 1
                if runLen >= minStack
                    if d == 1
                        stackBuy := true
                    else
                        stackSell := true
                    if showZones
                        topP = array.get(pUp, j)      // upper price of the highest level in the run
                        botP = array.get(pDn, i)      // lower price of the lowest level in the run
                        // Skip if an active zone of the same direction already covers this price range.
                        // (while instead of for — "for 0 to size-1" on an empty array yields 0..-1 and reads index 0)
                        overlaps = false
                        zi = 0
                        while zi < array.size(zones)
                            z = array.get(zones, zi)
                            if not z.mitigated and z.dir == d and topP >= z.bot and botP <= z.top
                                overlaps := true
                            zi += 1
                        if not overlaps
                            col   = d == 1 ? cBuy : cSell
                            transp = f_zoneTransp(runLen)
                            bx = box.new(bar_index, topP, bar_index, botP, xloc=xloc.bar_index, border_color=color.new(col, 25), border_width=1, bgcolor=color.new(col, transp))
                            label lb = na
                            if showCount
                                lb := label.new(bar_index, d == 1 ? botP : topP, str.tostring(runLen), xloc=xloc.bar_index, yloc=yloc.price, style=d == 1 ? label.style_label_up : label.style_label_down, color=color.new(col, 20), textcolor=color.white, size=size.small)
                            array.push(zones, Zone.new(topP, botP, d, runLen, bar_index, false, false, bx, lb))
                i := j + 1
            else
                i += 1

        // --- Zone count limit: remove the oldest beyond maxZones ---
        while array.size(zones) > maxZones
            z0 = array.shift(zones)
            box.delete(z0.bx)
            if not na(z0.lb)
                label.delete(z0.lb)

// --- Zone maintenance on each closed candle: mitigation + extending to the right ---
if barstate.isconfirmed
    mtLow  = mitUseClose ? close : low
    mtHigh = mitUseClose ? close : high
    k = 0
    while k < array.size(zones)
        z = array.get(zones, k)
        keep = true
        if not z.mitigated
            // Arm the test when price leaves the zone; mitigate when it comes back.
            if bar_index > z.startBar
                if not z.armed and ((z.dir == 1 and low > z.top) or (z.dir == -1 and high < z.bot))
                    z.armed := true
                if z.armed and ((z.dir == 1 and mtLow <= z.top) or (z.dir == -1 and mtHigh >= z.bot))
                    z.mitigated := true
            box.set_right(z.bx, bar_index)   // extend to now (or freeze on the mitigation candle)
            if z.mitigated
                if hideMitig
                    box.delete(z.bx)
                    if not na(z.lb)
                        label.delete(z.lb)
                    array.remove(zones, k)
                    keep := false
                else
                    col = z.dir == 1 ? cBuy : cSell
                    box.set_bgcolor(z.bx, color.new(col, tMitig))
                    box.set_border_style(z.bx, line.style_dashed)
        if keep
            k += 1

// --- Mini-dashboard (number of active zones + nearest above/below price) ---
var table dash = table.new(position.top_left, 2, 4, border_width=1, border_color=color.new(color.gray, 70))
if showDash and barstate.islast
    int   actBull = 0
    int   actBear = 0
    float nearAbove = na
    float nearBelow = na
    int   dirAbove = 0
    int   dirBelow = 0
    if array.size(zones) > 0
        for idx = 0 to array.size(zones) - 1
            z = array.get(zones, idx)
            if not z.mitigated
                if z.dir == 1
                    actBull += 1
                else
                    actBear += 1
                if z.bot > close and (na(nearAbove) or z.bot - close < nearAbove - close)
                    nearAbove := z.bot
                    dirAbove  := z.dir
                if z.top < close and (na(nearBelow) or close - z.top < close - nearBelow)
                    nearBelow := z.top
                    dirBelow  := z.dir
    dpos = dashPos == 'Top left' ? position.top_left : dashPos == 'Top right' ? position.top_right : dashPos == 'Bottom left' ? position.bottom_left : position.bottom_right
    table.set_position(dash, dpos)
    table.clear(dash, 0, 0, 1, 3)
    table.cell(dash, 0, 0, 'Zones ▲ bull',  text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 0, str.tostring(actBull), text_color=cBuy, text_size=size.small)
    table.cell(dash, 0, 1, 'Zones ▼ bear', text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 1, str.tostring(actBear), text_color=cSell, text_size=size.small)
    aboveTxt = na(nearAbove) ? '—' : str.tostring(nearAbove, format.mintick) + '  (+' + str.tostring(nearAbove - close, format.mintick) + ')'
    belowTxt = na(nearBelow) ? '—' : str.tostring(nearBelow, format.mintick) + '  (-' + str.tostring(close - nearBelow, format.mintick) + ')'
    table.cell(dash, 0, 2, 'Nearest above', text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 2, aboveTxt, text_color=na(nearAbove) ? color.gray : (dirAbove == 1 ? cBuy : cSell), text_size=size.small)
    table.cell(dash, 0, 3, 'Nearest below', text_color=color.gray, text_size=size.small)
    table.cell(dash, 1, 3, belowTxt, text_color=na(nearBelow) ? color.gray : (dirBelow == 1 ? cBuy : cSell), text_size=size.small)

// --- Alerts (a stacked imbalance forming) ---
alertcondition(stackBuy,  'Stacked buy imbalance',  'New stacked buy imbalance zone (accumulation / support)')
alertcondition(stackSell, 'Stacked sell imbalance', 'New stacked sell imbalance zone (distribution / resistance)')
