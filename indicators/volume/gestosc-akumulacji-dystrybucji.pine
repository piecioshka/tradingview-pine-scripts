//@version=6
indicator('Gęstość Akumulacji / Dystrybucji', overlay=true)

// Gęstość akumulacji / dystrybucji (VD) — wzorowany na wskaźniku Mieczysława Siudka z xStation (XTB).
// Szuka świec, w których stosunek wolumenu do ruchu ceny (gęstość = wolumen na jednostkę amplitudy)
// jest nieproporcjonalnie zawyżony i które wyznaczają lokalne ekstremum. Duży obrót przy małym ruchu
// na dołku/szczycie sugeruje akumulację/dystrybucję pozycji i potencjalny punkt zwrotny.
// ▲ zielony trójkąt pod świecą  = gęstość akumulacji  (potencjalny sygnał wzrostowy),
// ▼ czerwony trójkąt nad świecą = gęstość dystrybucji (potencjalny sygnał spadkowy).
// Sygnał na niedomkniętej świecy może zniknąć do jej zamknięcia (warunki liczone z bieżących wartości).

cBuy  = color.rgb(38, 166, 154)  // akumulacja — domyślna zieleń świecy #26A69A
cSell = color.rgb(239, 83, 80)   // dystrybucja — domyślna czerwień świecy #EF5350

g = 'Parametry'
lenExtreme    = input.int(10, 'Max./Min. z (świec)', minval=1, group=g, tooltip='Liczba wcześniejszych świec, względem których świeca sygnałowa musi wyznaczać nowy dołek (akumulacja) lub nowy szczyt (dystrybucja).')
lenSpread     = input.int(10, 'Średni Spread z (świec)', minval=1, group=g, tooltip='Liczba świec do średniej amplitudy (high − low).')
lenDensity    = input.int(10, 'Średnia Gęstość z (świec)', minval=1, group=g, tooltip='Liczba świec do średniej gęstości (wolumen / amplituda).')
useSpread     = input.bool(true, 'Warunek spreadu', group=g, tooltip='Wymagaj, by amplituda świecy sygnałowej nie przekraczała Współczynnik Spreadu × średnia amplituda (świeca nie może być za duża — gęstość to duży obrót przy MAŁYM ruchu).')
spreadFactor  = input.float(2.0, 'Współczynnik Spreadu', minval=0.1, step=0.1, group=g, tooltip='O ile większa może być amplituda świecy sygnałowej od średniej, by sygnał się pojawił.')
densityFactor = input.float(1.5, 'Współczynnik Gęstości', minval=1.0, step=0.1, group=g, tooltip='O ile gęstość świecy sygnałowej musi przewyższać średnią gęstość.')
closePct      = input.int(50, 'Zamknięcie bara (%)', minval=0, maxval=100, group=g, tooltip='Filtr pozycji zamknięcia w amplitudzie świecy: dla akumulacji zamknięcie co najmniej X% od dołu świecy, dla dystrybucji co najmniej X% od góry. 0 wyłącza filtr.')

spread  = high - low
density = volume / math.max(spread, syminfo.mintick)   // wolumen na jednostkę ruchu; doji z zerową amplitudą → wolumen na 1 tick

// Średnie liczone z okna KOŃCZĄCEGO SIĘ na poprzedniej świecy — świeca sygnałowa nie zawyża własnego progu.
avgSpread  = ta.sma(spread, lenSpread)[1]
avgDensity = ta.sma(density, lenDensity)[1]

isNewLow  = low <= ta.lowest(low, lenExtreme)[1]
isNewHigh = high >= ta.highest(high, lenExtreme)[1]

densityOK = density >= densityFactor * avgDensity
spreadOK  = not useSpread or spread <= spreadFactor * avgSpread

// Pozycja zamknięcia w amplitudzie świecy (0–100); świeca bez amplitudy przechodzi filtr w obu kierunkach
posFromLow  = spread > 0 ? (close - low) / spread * 100 : 100
posFromHigh = spread > 0 ? (high - close) / spread * 100 : 100

accSignal  = volume > 0 and isNewLow and densityOK and spreadOK and posFromLow >= closePct
distSignal = volume > 0 and isNewHigh and densityOK and spreadOK and posFromHigh >= closePct

plotshape(accSignal, 'Gęstość akumulacji', style=shape.triangleup, location=location.belowbar, color=cBuy, size=size.small)
plotshape(distSignal, 'Gęstość dystrybucji', style=shape.triangledown, location=location.abovebar, color=cSell, size=size.small)

alertcondition(accSignal, 'Gęstość akumulacji', 'Gęstość akumulacji — potencjalny sygnał wzrostowy (duży wolumen przy małym ruchu na nowym dołku)')
alertcondition(distSignal, 'Gęstość dystrybucji', 'Gęstość dystrybucji — potencjalny sygnał spadkowy (duży wolumen przy małym ruchu na nowym szczycie)')
