// @version=6
indicator('Bollinger Bands', overlay = true, max_labels_count=500)

aColor = color.rgb(114, 48, 131)
bColor = color.rgb(240, 199, 58)

len = input.int(20, 'SMA')
mult = input.float(2.0, 'StdDev', minval=0.001, step=0.5)
showTrades = input.bool(true, 'LONG / SELL labels', tooltip='Mean-reversion signals: LONG when close drops below the lower band (bet on a return to the mean), SELL when close rises above the upper band.')

std = ta.stdev(close, len)
sma = ta.sma(close, len)
upper = sma + mult * std
lower = sma - mult * std

center = plot(sma, color=color.new(color.white, 30), force_overlay=true)
plotUpper = plot(upper, color=aColor, force_overlay=true)
plotLower = plot(lower, color=bColor, force_overlay=true)

fill(plotUpper, center, color = color.new(aColor, 90))
fill(center, plotLower, color = color.new(bColor, 90))

// --- LONG / SELL trade labels (mean reversion on the bands) ---
longTrade = ta.crossunder(close, lower)
sellTrade = ta.crossover(close, upper)

if showTrades and longTrade
    label.new(bar_index, na, 'LONG', yloc=yloc.belowbar, style=label.style_label_up, color=color.new(color.green, 20), textcolor=color.white, size=size.small)
if showTrades and sellTrade
    label.new(bar_index, na, 'SELL', yloc=yloc.abovebar, style=label.style_label_down, color=color.new(color.red, 20), textcolor=color.white, size=size.small)
