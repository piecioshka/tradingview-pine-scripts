//@version=6
// Draws vertical lines at the given hours — up to 10 slots, each with its own
// color, style, and width. Lines appear on the bar where the given hour's
// threshold is first crossed (works on any intraday timeframe, including ones
// that do not hit the hour exactly).
indicator('Vertical Hour Lines', overlay = true, max_lines_count = 500)

GRP = 'Lines'
DEF_COLOR = color.new(#BA8FFF, 70)
DEF_STYLE = 'Dashed'

on1 = input.bool(true, 'Enable', inline = '1', group = GRP)
at1 = input.string('10:30', '', inline = '1', group = GRP)
color1 = input.color(DEF_COLOR, '', inline = '1', group = GRP)
style1 = input.string(DEF_STYLE, '', options = ['Solid', 'Dashed', 'Dotted'], inline = '1', group = GRP)
width1 = input.int(1, '', minval = 1, maxval = 4, inline = '1', group = GRP)

on2 = input.bool(true, 'Enable', inline = '2', group = GRP)
at2 = input.string('15:00', '', inline = '2', group = GRP)
color2 = input.color(DEF_COLOR, '', inline = '2', group = GRP)
style2 = input.string(DEF_STYLE, '', options = ['Solid', 'Dashed', 'Dotted'], inline = '2', group = GRP)
width2 = input.int(1, '', minval = 1, maxval = 4, inline = '2', group = GRP)

on3 = input.bool(true, 'Enable', inline = '3', group = GRP)
at3 = input.string('20:00', '', inline = '3', group = GRP)
color3 = input.color(DEF_COLOR, '', inline = '3', group = GRP)
style3 = input.string(DEF_STYLE, '', options = ['Solid', 'Dashed', 'Dotted'], inline = '3', group = GRP)
width3 = input.int(1, '', minval = 1, maxval = 4, inline = '3', group = GRP)

on4 = input.bool(true, 'Enable', inline = '4', group = GRP)
at4 = input.string('23:00', '', inline = '4', group = GRP)
color4 = input.color(DEF_COLOR, '', inline = '4', group = GRP)
style4 = input.string(DEF_STYLE, '', options = ['Solid', 'Dashed', 'Dotted'], inline = '4', group = GRP)
width4 = input.int(1, '', minval = 1, maxval = 4, inline = '4', group = GRP)

on5 = input.bool(false, 'Enable', inline = '5', group = GRP)
at5 = input.string('09:00', '', inline = '5', group = GRP)
color5 = input.color(DEF_COLOR, '', inline = '5', group = GRP)
style5 = input.string(DEF_STYLE, '', options = ['Solid', 'Dashed', 'Dotted'], inline = '5', group = GRP)
width5 = input.int(1, '', minval = 1, maxval = 4, inline = '5', group = GRP)

on6 = input.bool(false, 'Enable', inline = '6', group = GRP)
at6 = input.string('09:00', '', inline = '6', group = GRP)
color6 = input.color(DEF_COLOR, '', inline = '6', group = GRP)
style6 = input.string(DEF_STYLE, '', options = ['Solid', 'Dashed', 'Dotted'], inline = '6', group = GRP)
width6 = input.int(1, '', minval = 1, maxval = 4, inline = '6', group = GRP)

on7 = input.bool(false, 'Enable', inline = '7', group = GRP)
at7 = input.string('09:00', '', inline = '7', group = GRP)
color7 = input.color(DEF_COLOR, '', inline = '7', group = GRP)
style7 = input.string(DEF_STYLE, '', options = ['Solid', 'Dashed', 'Dotted'], inline = '7', group = GRP)
width7 = input.int(1, '', minval = 1, maxval = 4, inline = '7', group = GRP)

on8 = input.bool(false, 'Enable', inline = '8', group = GRP)
at8 = input.string('09:00', '', inline = '8', group = GRP)
color8 = input.color(DEF_COLOR, '', inline = '8', group = GRP)
style8 = input.string(DEF_STYLE, '', options = ['Solid', 'Dashed', 'Dotted'], inline = '8', group = GRP)
width8 = input.int(1, '', minval = 1, maxval = 4, inline = '8', group = GRP)

on9 = input.bool(false, 'Enable', inline = '9', group = GRP)
at9 = input.string('09:00', '', inline = '9', group = GRP)
color9 = input.color(DEF_COLOR, '', inline = '9', group = GRP)
style9 = input.string(DEF_STYLE, '', options = ['Solid', 'Dashed', 'Dotted'], inline = '9', group = GRP)
width9 = input.int(1, '', minval = 1, maxval = 4, inline = '9', group = GRP)

on10 = input.bool(false, 'Enable', inline = '10', group = GRP)
at10 = input.string('09:00', '', inline = '10', group = GRP)
color10 = input.color(DEF_COLOR, '', inline = '10', group = GRP)
style10 = input.string(DEF_STYLE, '', options = ['Solid', 'Dashed', 'Dotted'], inline = '10', group = GRP)
width10 = input.int(1, '', minval = 1, maxval = 4, inline = '10', group = GRP)

// Hours are computed in this time zone. Default is "Warsaw" because the chart
// time axis usually shows the user's time zone, not the exchange's — with the
// exchange time zone the lines land shifted relative to what the axis shows.
tzMode = input.string('Warsaw', 'Time zone', options = ['Warsaw', 'London', 'New York', 'Exchange', 'UTC', 'Custom'], group = 'General')
tzCustom = input.string('Europe/Warsaw', 'Custom time zone (IANA)', group = 'General', tooltip = 'Used only when "Custom" is selected. E.g. Europe/Berlin, America/Chicago, Asia/Tokyo.')
extendMode = input.string('Whole chart', 'Extend', options = ['Whole chart', 'Only up', 'Only down'], group = 'General')

tz = switch tzMode
    'Warsaw' => 'Europe/Warsaw'
    'London' => 'Europe/London'
    'New York' => 'America/New_York'
    'Exchange' => syminfo.timezone
    'UTC' => 'UTC'
    => tzCustom

lineStyleOf(string name) =>
    switch name
        'Solid' => line.style_solid
        'Dotted' => line.style_dotted
        => line.style_dashed

extendOf = switch extendMode
    'Only up' => extend.right
    'Only down' => extend.left
    => extend.both

// "10:30" -> 630 minutes from midnight; returns na for a malformed value
minutesOf(string hhmm) =>
    parts = str.split(str.replace_all(hhmm, ' ', ''), ':')
    int result = na
    if array.size(parts) == 2
        h = str.tonumber(array.get(parts, 0))
        m = str.tonumber(array.get(parts, 1))
        if not na(h) and not na(m) and h >= 0 and h <= 23 and m >= 0 and m <= 59
            result := int(h) * 60 + int(m)
    result

nowMinutes = hour(time, tz) * 60 + minute(time, tz)
prevMinutes = nowMinutes[1]
newDay = dayofmonth(time, tz) != dayofmonth(time[1], tz)

// A bar "hits" the threshold when its time has reached it while the previous
// bar's had not. The start-of-day reset handles the case where the first bar
// of the session is already past the threshold (e.g. the threshold falls in a
// trading break).
crossedAt(int target) =>
    firstOfDay = newDay or na(prevMinutes)
    na(target) ? false : nowMinutes >= target and (firstOfDay or prevMinutes < target)

drawAt(bool enabled, string hhmm, color col, string styleName, int width) =>
    target = minutesOf(hhmm)
    if enabled and crossedAt(target)
        line.new(bar_index, low, bar_index, high, xloc = xloc.bar_index, extend = extendOf, color = col, style = lineStyleOf(styleName), width = width)

drawAt(on1, at1, color1, style1, width1)
drawAt(on2, at2, color2, style2, width2)
drawAt(on3, at3, color3, style3, width3)
drawAt(on4, at4, color4, style4, width4)
drawAt(on5, at5, color5, style5, width5)
drawAt(on6, at6, color6, style6, width6)
drawAt(on7, at7, color7, style7, width7)
drawAt(on8, at8, color8, style8, width8)
drawAt(on9, at9, color9, style9, width9)
drawAt(on10, at10, color10, style10, width10)
