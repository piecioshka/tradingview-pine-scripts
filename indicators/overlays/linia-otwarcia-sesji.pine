//@version=6
// Rysuje poziomą linię na cenie otwarcia sesji — od pierwszego do ostatniego
// bara sesji. Na ostatnim barze sesji po prawej stronie linii pojawia się
// jedna etykieta z procentową zmianą ceny podczas sesji (zamknięcie vs
// otwarcie sesji). Kolor linii i etykiety zależy od znaku zmiany. Działa na
// interwałach intraday — na D i wyższych każdy bar to osobna sesja, więc
// wskaźnik pokazuje tylko podpowiedź.
indicator('Linia otwarcia sesji', overlay = true, max_lines_count = 500, max_labels_count = 500)

GRP = 'Wygląd'
upColor = input.color(#26A69A, 'Kolor wzrostu', group = GRP)
downColor = input.color(#EF5350, 'Kolor spadku', group = GRP)
lineStyleName = input.string('Ciągła', 'Styl linii', options = ['Ciągła', 'Przerywana', 'Kropkowana'], group = GRP)
lineWidth = input.int(1, 'Grubość linii', minval = 1, maxval = 4, group = GRP)
textSizeName = input.string('Mały', 'Rozmiar tekstu', options = ['Malutki', 'Mały', 'Normalny', 'Duży'], group = GRP)
showLive = input.bool(false, 'Pokazuj procent w trakcie sesji', group = 'Ogólne', tooltip = 'Włączone: etykieta podąża za ostatnim barem i pokazuje bieżącą zmianę. Wyłączone: jedna wartość pojawia się dopiero na ostatnim barze sesji.')

lineStyle = switch lineStyleName
    'Przerywana' => line.style_dashed
    'Kropkowana' => line.style_dotted
    => line.style_solid

textSize = switch textSizeName
    'Malutki' => size.tiny
    'Normalny' => size.normal
    'Duży' => size.large
    => size.small

fmtPct(float pct) =>
    (pct >= 0 ? '+' : '') + str.tostring(pct, '0.00') + '%'

newLabel(int x, float y, float pct, string sizeName) =>
    label.new(x, y, fmtPct(pct), xloc = xloc.bar_index, style = label.style_label_left, textcolor = pct >= 0 ? upColor : downColor, color = color.new(color.black, 100), size = sizeName)

// time('D') zmienia się na pierwszym barze dnia handlowego, więc działa też
// dla sesji przechodzących przez północ (np. futures).
newSession = timeframe.change('D')

var line ln = na
var label lb = na
var float sessionOpen = na

if timeframe.isintraday
    if newSession or barstate.isfirst
        // Sesja skończyła się, a etykieta nie powstała (session.islastbar nie
        // oznaczył ostatniego bara, np. przy skróconej sesji) — dopisz wynik.
        if not na(sessionOpen) and na(lb)
            newLabel(bar_index - 1, sessionOpen, (close[1] - sessionOpen) / sessionOpen * 100, textSize)
        sessionOpen := open
        ln := line.new(bar_index, open, bar_index, open, xloc = xloc.bar_index, color = upColor, style = lineStyle, width = lineWidth)
        lb := na

    if not na(ln)
        pct = (close - sessionOpen) / sessionOpen * 100
        col = pct >= 0 ? upColor : downColor
        line.set_x2(ln, bar_index)
        line.set_color(ln, col)
        if showLive or session.islastbar
            if na(lb)
                lb := newLabel(bar_index, sessionOpen, pct, textSize)
            else
                label.set_x(lb, bar_index)
                label.set_text(lb, fmtPct(pct))
                label.set_textcolor(lb, col)
else
    if barstate.islast
        var table hint = table.new(position.top_right, 1, 1)
        table.cell(hint, 0, 0, 'Linia otwarcia sesji: wskaźnik działa na interwałach intraday', text_color = color.gray, text_size = size.small)
