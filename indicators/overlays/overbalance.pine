//@version=6
// Overbalance - market geometry popularized by Łukasz Stefanik. The largest
// correction of the running trend becomes the reference: while every new
// correction stays below it, the trend is healthy; the moment price travels
// further than the reference away from the trend extreme, the trend is broken.
//
// Corrections are measured between confirmed swings (ta.pivothigh /
// ta.pivotlow) and anything below the noise filter is skipped - the method
// treats moves under 40 points on DAX as noise. The reference is always the
// LARGEST correction of the trend, never the last one, and the threshold line
// sits one reference away from the trend extreme, which is where the method
// puts the stop loss. The break is detected intrabar, on the very bar that
// crosses the level, not on the next confirmed swing.
indicator('Overbalance', overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

GRP_SWING = 'Swings'
GRP_LOGIC = 'Overbalance'
GRP_ZIGZAG = 'Zigzag'
GRP_THRESHOLD = 'Threshold level'
GRP_BOXES = 'Correction boxes'
GRP_SIGNAL = 'Signal'

leftBars = input.int(5, 'Pivot left bars', minval = 1, group = GRP_SWING, tooltip = 'Bars to the left of a pivot that must be lower (for a high) or higher (for a low).')
rightBars = input.int(5, 'Pivot right bars', minval = 1, group = GRP_SWING, tooltip = 'Bars to the right of a pivot. A swing is confirmed this many bars after it happened, so corrections enter the measurement with that delay. The break itself is detected intrabar and is not delayed.')

minCorrection = input.float(40, 'Noise filter', minval = 0, step = 1, group = GRP_LOGIC, tooltip = 'Corrections smaller than this never become the reference. The method uses 40 points on DAX - recalibrate for any other instrument. Set 0 to measure every correction.')
noiseUnitName = input.string('Points', 'Noise filter unit', options = ['Points', 'Percent', 'ATR'], group = GRP_LOGIC, tooltip = 'Points: absolute price distance (DAX points). Percent: share of the price. ATR: multiple of ATR(14), which adapts the filter to the volatility of any instrument.')
modeName = input.string('Price', 'Mode', options = ['Price', 'Price + Time'], group = GRP_LOGIC, tooltip = 'Price: the method as described - only the size of the correction counts. Price + Time (Gann): a correction must also last longer than the reference one to replace it.')
flipOnBreak = input.bool(true, 'Flip trend after break', group = GRP_LOGIC, tooltip = 'On: a broken trend immediately becomes a trend in the opposite direction. Off: the trend goes undefined and waits for a fresh swing sequence - closer to the method, which says to close the position and only then look for a signal the other way.')

showZigzag = input.bool(true, 'Show zigzag', group = GRP_ZIGZAG)
zigzagUpColor = input.color(#26A69A, 'Up leg color', group = GRP_ZIGZAG)
zigzagDownColor = input.color(#EF5350, 'Down leg color', group = GRP_ZIGZAG)
zigzagWidth = input.int(2, 'Line width', minval = 1, maxval = 4, group = GRP_ZIGZAG)

showThreshold = input.bool(true, 'Show threshold line', group = GRP_THRESHOLD, tooltip = 'A horizontal line one reference correction away from the trend extreme - the level that breaks the trend, and where the method puts the stop loss.')
thresholdColor = input.color(#FF9800, 'Line color', group = GRP_THRESHOLD)
thresholdStyleName = input.string('Dashed', 'Line style', options = ['Solid', 'Dashed', 'Dotted'], group = GRP_THRESHOLD)
thresholdWidth = input.int(1, 'Line width', minval = 1, maxval = 4, group = GRP_THRESHOLD)
showThresholdLabel = input.bool(true, 'Show threshold value', group = GRP_THRESHOLD)
showBrokenLevels = input.bool(true, 'Keep broken levels', group = GRP_THRESHOLD, tooltip = 'Leave the threshold line on the chart at the point where price broke it, instead of removing it together with the trend that owned it.')

showBoxes = input.bool(true, 'Show correction boxes', group = GRP_BOXES, tooltip = 'A rectangle over every measured correction - its height is the size, its width the duration. Corrections filtered out as noise get no box.')
boxUpColor = input.color(color.new(#26A69A, 85), 'Up correction color', group = GRP_BOXES, tooltip = 'Correction inside a downtrend - a bounce up.')
boxDownColor = input.color(color.new(#EF5350, 85), 'Down correction color', group = GRP_BOXES, tooltip = 'Correction inside an uptrend - a pullback down.')
boxBorderColor = input.color(color.new(color.gray, 60), 'Border color', group = GRP_BOXES)
highlightReference = input.bool(true, 'Highlight the reference', group = GRP_BOXES, tooltip = 'Give the largest correction of the trend - the one acting as the reference - a solid, thicker border.')

showSignal = input.bool(true, 'Show signal markers', group = GRP_SIGNAL)
signalShapeName = input.string('Triangle', 'Marker shape', options = ['Triangle', 'Arrow', 'Label arrow', 'Circle', 'Diamond'], group = GRP_SIGNAL)
signalSizeName = input.string('Small', 'Marker size', options = ['Tiny', 'Small', 'Normal', 'Large'], group = GRP_SIGNAL)
signalUpColor = input.color(#26A69A, 'Bullish signal color', group = GRP_SIGNAL, tooltip = 'A downtrend broken to the upside.')
signalDownColor = input.color(#EF5350, 'Bearish signal color', group = GRP_SIGNAL, tooltip = 'An uptrend broken to the downside.')
showSignalLabel = input.bool(true, 'Show signal label', group = GRP_SIGNAL, tooltip = 'A label with the size of the reference correction that price broke through.')
labelUnitName = input.string('Points', 'Label unit', options = ['Points', 'Percent'], group = GRP_SIGNAL)
textSizeName = input.string('Small', 'Text size', options = ['Auto', 'Tiny', 'Small', 'Normal', 'Large'], group = GRP_SIGNAL)

thresholdStyle = switch thresholdStyleName
    'Dashed' => line.style_dashed
    'Dotted' => line.style_dotted
    => line.style_solid

textSize = switch textSizeName
    'Auto' => size.auto
    'Tiny' => size.tiny
    'Normal' => size.normal
    'Large' => size.large
    => size.small

signalSize = switch signalSizeName
    'Tiny' => size.tiny
    'Normal' => size.normal
    'Large' => size.large
    => size.small

useTime = modeName == 'Price + Time'

// The noise filter in price units. ATR keeps it proportional to the volatility
// of whatever instrument the script runs on.
atr = ta.atr(14)
noiseFloor = switch noiseUnitName
    'Percent' => close * minCorrection / 100
    'ATR' => atr * minCorrection
    => minCorrection

// Confirmed swings. ta.pivothigh returns the pivot price rightBars after the
// pivot bar, so every swing lands at bar_index - rightBars.
pivotHigh = ta.pivothigh(high, leftBars, rightBars)
pivotLow = ta.pivotlow(low, leftBars, rightBars)

// Last confirmed swing - its price, bar and whether it was a high.
var float lastSwingPrice = na
var int lastSwingBar = na
// Guarded by trend != 0 everywhere it is read - `na` here would make Pine
// infer a "const bool" type that cannot be reassigned.
var bool lastSwingIsHigh = false

// The reference: the largest correction of the running trend, never the last
// one. refBars carries its duration for the Price + Time mode.
var float refRange = na
var int refBars = na
var box refBox = na

// The extreme of the running trend - the high of an uptrend, the low of a
// downtrend. The threshold is measured from here, so it has to track price
// beyond the last confirmed swing.
var float trendExtreme = na
var int trendExtremeBar = na

// Trend direction implied by the swing sequence: 1 up, -1 down, 0 unknown.
var int trend = 0

var line thresholdLine = na
var label thresholdLabel = na

fmtSize(float priceRange, float basePrice) =>
    labelUnitName == 'Percent' and basePrice != 0 ? str.tostring(priceRange / basePrice * 100, '0.00') + '%' : str.tostring(priceRange, format.mintick)

// Registering a confirmed swing happens in global scope - Pine forbids
// assigning to global variables inside a user-defined function. Both pivots
// can confirm on the same bar, so the block runs once per pivot type.
float swingPrice = na
bool swingIsHigh = false
for pass = 0 to 1
    swingPrice := pass == 0 ? pivotHigh : pivotLow
    swingIsHigh := pass == 0

    if not na(swingPrice)
        swingBar = bar_index - rightBars

        if not na(lastSwingPrice)
            if showZigzag
                line.new(lastSwingBar, lastSwingPrice, swingBar, swingPrice, xloc = xloc.bar_index, color = swingIsHigh ? zigzagUpColor : zigzagDownColor, width = zigzagWidth)

            legRange = math.abs(swingPrice - lastSwingPrice)
            legBars = swingBar - lastSwingBar

            // A correction runs against the trend: inside an uptrend the
            // high -> low leg, inside a downtrend the low -> high one.
            isCorrection = (trend == 1 and not swingIsHigh) or (trend == -1 and swingIsHigh)

            if trend == 0
                // No trend yet - the first leg clearing the noise filter sets
                // the direction and seeds the extreme.
                if legRange >= noiseFloor
                    trend := swingIsHigh ? 1 : -1
                    trendExtreme := swingPrice
                    trendExtremeBar := swingBar
            else if isCorrection and legRange >= noiseFloor
                // A correction worth measuring. It cannot break the trend here
                // - that is detected intrabar below - so the only job left is
                // promoting it to the reference when it is the largest so far.
                newBox = showBoxes ? box.new(lastSwingBar, math.max(lastSwingPrice, swingPrice), swingBar, math.min(lastSwingPrice, swingPrice), xloc = xloc.bar_index, bgcolor = swingIsHigh ? boxUpColor : boxDownColor, border_color = boxBorderColor, border_style = line.style_dotted) : na

                priceLarger = na(refRange) or legRange > refRange
                timeLarger = na(refBars) or legBars > refBars
                larger = useTime ? priceLarger and timeLarger : priceLarger

                if larger
                    refRange := legRange
                    refBars := legBars
                    if highlightReference
                        if not na(refBox)
                            box.set_border_style(refBox, line.style_dotted)
                            box.set_border_width(refBox, 1)
                        if not na(newBox)
                            box.set_border_style(newBox, line.style_solid)
                            box.set_border_width(newBox, 2)
                    refBox := newBox
            else if not isCorrection
                // An impulse leg - it may push the trend extreme further out.
                if trend == 1 and swingIsHigh and (na(trendExtreme) or swingPrice > trendExtreme)
                    trendExtreme := swingPrice
                    trendExtremeBar := swingBar
                if trend == -1 and not swingIsHigh and (na(trendExtreme) or swingPrice < trendExtreme)
                    trendExtreme := swingPrice
                    trendExtremeBar := swingBar

        lastSwingPrice := swingPrice
        lastSwingBar := swingBar
        lastSwingIsHigh := swingIsHigh

// Price runs ahead of the confirmed swings, so the trend extreme tracks it bar
// by bar - otherwise the threshold would trail a stale high.
if trend == 1 and not na(trendExtreme) and high > trendExtreme
    trendExtreme := high
    trendExtremeBar := bar_index
if trend == -1 and not na(trendExtreme) and low < trendExtreme
    trendExtreme := low
    trendExtremeBar := bar_index

// The level that breaks the trend: one reference correction away from the
// trend extreme. This is where the method puts the stop loss.
level = na(refRange) or na(trendExtreme) or trend == 0 ? na : trend == 1 ? trendExtreme - refRange : trendExtreme + refRange

// The break, checked on every bar - so the signal lands where the stop would
// actually be hit, not on the next confirmed swing.
broken = not na(level) and (trend == 1 ? low <= level : high >= level)

if broken
    bullish = trend == -1
    col = bullish ? signalUpColor : signalDownColor

    if showSignal
        labelStyle = switch signalShapeName
            'Arrow' => bullish ? label.style_arrowup : label.style_arrowdown
            'Label arrow' => bullish ? label.style_label_up : label.style_label_down
            'Circle' => label.style_circle
            'Diamond' => label.style_diamond
            => bullish ? label.style_triangleup : label.style_triangledown
        label.new(bar_index, level, '', xloc = xloc.bar_index, style = labelStyle, color = col, size = signalSize)

    if showSignalLabel
        label.new(bar_index, level, (bullish ? 'OB ▲ ' : 'OB ▼ ') + fmtSize(refRange, level), xloc = xloc.bar_index, style = bullish ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = col, size = textSize)

    // Freeze the broken level on the chart before the state resets.
    if showBrokenLevels and not na(thresholdLine)
        line.set_x2(thresholdLine, bar_index)
        thresholdLine := na
    if not na(thresholdLabel)
        label.delete(thresholdLabel)
        thresholdLabel := na

    // The reference belonged to the trend that just died.
    refRange := na
    refBars := na
    refBox := na

    if flipOnBreak
        // The new trend runs the way the breaking move went, and the level it
        // broke through is its first extreme.
        trend := -trend
        trendExtreme := trend == 1 ? high : low
        trendExtremeBar := bar_index
    else
        // Undefined until a fresh swing sequence sets a direction.
        trend := 0
        trendExtreme := na
        trendExtremeBar := na

alertcondition(broken, 'Overbalance broken', 'Overbalance level broken - the trend is no longer valid')

// The live threshold - redrawn on the last bar so it always sits one reference
// correction away from the current trend extreme.
if barstate.islast
    if not na(thresholdLine)
        line.delete(thresholdLine)
    if not na(thresholdLabel)
        label.delete(thresholdLabel)
    thresholdLine := na
    thresholdLabel := na

    if showThreshold and not na(level)
        thresholdLine := line.new(trendExtremeBar, level, bar_index + 10, level, xloc = xloc.bar_index, color = thresholdColor, style = thresholdStyle, width = thresholdWidth)
        if showThresholdLabel
            txt = 'Overbalance ' + fmtSize(refRange, level) + (useTime and not na(refBars) ? ' / ' + str.tostring(refBars) + ' bars' : '')
            thresholdLabel := label.new(bar_index + 10, level, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.black, 100), textcolor = thresholdColor, size = textSize)
