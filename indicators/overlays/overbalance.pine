//@version=6
// Overbalance - market geometry described by Bryce Gilmore and popularized in
// Poland by Łukasz Stefanik. One sentence carries the whole method: the trend
// lasts as long as the largest correction of that trend is not permanently
// broken.
//
// The largest correction becomes the "magic rectangle" - measured high to low
// (uptrend) between two confirmed swings, then extended to the right as a live
// zone. The method trades that rectangle: join the trend at its far edge, aim
// for the top of the setup, and treat the trend as broken only once price
// leaves the rectangle by a tolerance of the overbalance range. That tolerance
// is what "permanently" means - 13% is the tightest reading, 33% the safest,
// and the choice trades win rate against reward to risk.
//
// Corrections are compared to corrections, never to impulses, and anything
// below the noise filter is skipped - the method treats moves under 40 points
// on DAX as noise. Higher timeframes (H4, D1) are where the setups live.
indicator('Overbalance', overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500)

// xloc.bar_index drawings must stay within roughly 10000 bars of the current
// bar; a margin keeps the clamp safely inside that limit.
MAX_BARS_BACK = 9000

GRP_SWING = 'Swings'
GRP_LOGIC = 'Overbalance'
GRP_RECT = 'Overbalance rectangle'
GRP_LEVELS = 'Trade levels'
GRP_ZIGZAG = 'Zigzag'
GRP_SIGNAL = 'Signal'
GRP_PANEL = 'Diagnostics'

leftBars = input.int(5, 'Pivot left bars', minval = 1, group = GRP_SWING, tooltip = 'Bars to the left of a pivot that must be lower (for a high) or higher (for a low).')
rightBars = input.int(5, 'Pivot right bars', minval = 1, group = GRP_SWING, tooltip = 'Bars to the right of a pivot. A swing is confirmed this many bars after it happened, so a correction enters the measurement with that delay. The break itself is detected intrabar and is not delayed.')

minCorrection = input.float(1, 'Noise filter', minval = 0, step = 0.1, group = GRP_LOGIC, tooltip = 'Corrections smaller than this never become the overbalance. Read together with the unit below: the default 1 ATR adapts to any instrument, while the method itself is calibrated as 40 POINTS on DAX - switch the unit to Points and set 40 to reproduce it exactly. Set 0 to measure every correction.')
noiseUnitName = input.string('ATR', 'Noise filter unit', options = ['ATR', 'Points', 'Percent'], group = GRP_LOGIC, tooltip = 'ATR: multiple of ATR(14) - adapts to the volatility of any instrument, which is why it is the default. Points: absolute price distance, the unit the method is written in (40 on DAX) - a value calibrated for one instrument draws nothing on another. Percent: share of the price.')
referenceName = input.string('First correction', 'Reference correction', options = ['First correction', 'Largest so far', 'Last correction'], group = GRP_LOGIC, tooltip = 'Which correction the rectangle is built from. First correction: the first 3-wave structure of the trend, which the sources name as the one that "conducts the trend" - it stays put, so the geometry does not drift. Largest so far: the literal reading of "the largest correction in the trend" - true to the wording, but the rectangle keeps growing and on a long trend it swells to the size of the whole range. Last correction: always the freshest structure. The method is not formalized on this point, so the choice is yours; First is the default because it is the only one anchored in the sources that also stays readable.')

tolerancePct = input.float(33, 'Break tolerance (%)', minval = 0, maxval = 100, step = 1, group = GRP_LOGIC, tooltip = 'How far past the rectangle price must travel before the trend counts as permanently broken, as a share of the overbalance range. The method names 13%, 20% and 33% - the tighter the value, the more often you are stopped out and the better the reward to risk. 0 breaks the trend the moment price touches the edge.')
useCloseForBreak = input.bool(false, 'Break on close only', group = GRP_LOGIC, tooltip = 'On: only a bar CLOSING beyond the tolerance breaks the trend - a wick through it is ignored. Off: any trade through the level counts, which is what a resting stop order would do.')
flipOnBreak = input.bool(false, 'Flip trend after break', group = GRP_LOGIC, tooltip = 'Off (default): after a break the trend goes undefined and the indicator waits for a fresh swing sequence to build a new setup - this is what the method describes, close the position and only then look for a signal the other way, and it stops price from falling straight back into the old rectangle and breaking it again and again. On: the broken trend immediately becomes a trend in the opposite direction, which reacts faster but cascades into repeated breaks around one level.')

showRect = input.bool(true, 'Show the rectangle', group = GRP_RECT, tooltip = 'The magic rectangle - the largest correction of the running trend, extended to the right as the live zone the method trades.')
rectUpColor = input.color(color.new(#26A69A, 88), 'Uptrend fill', group = GRP_RECT)
rectDownColor = input.color(color.new(#EF5350, 88), 'Downtrend fill', group = GRP_RECT)
rectBorderColor = input.color(#FF9800, 'Border color', group = GRP_RECT)
rectExtend = input.int(30, 'Extend right (bars)', minval = 0, group = GRP_RECT, tooltip = 'How far past the current bar the live rectangle reaches.')
showHistory = input.bool(true, 'Keep broken rectangles', group = GRP_RECT, tooltip = 'Leave every overbalance rectangle on the chart after its trend ends, so past setups stay readable.')

showEntry = input.bool(true, 'Entry level', group = GRP_LEVELS, tooltip = 'The far edge of the rectangle - where the method joins the trend after a correction that stayed inside the overbalance.')
showStop = input.bool(true, 'Stop loss level', group = GRP_LEVELS, tooltip = 'The tolerance level past the rectangle - the price that permanently breaks the setup.')
showTarget = input.bool(true, 'Target level', group = GRP_LEVELS, tooltip = 'The trend extreme - the minimum target the method names for a position taken at the entry level.')
entryColor = input.color(#2962FF, 'Entry color', group = GRP_LEVELS)
stopColor = input.color(#EF5350, 'Stop color', group = GRP_LEVELS)
targetColor = input.color(#26A69A, 'Target color', group = GRP_LEVELS)
showRR = input.bool(true, 'Show reward to risk', group = GRP_LEVELS, tooltip = 'Label the entry with the ratio between the distance to the target and the distance to the stop.')
levelExtend = input.int(30, 'Extend right (bars)', minval = 0, group = GRP_LEVELS)

panelModeName = input.string('When empty', 'Diagnostics panel', options = ['Off', 'When empty', 'Always'], group = GRP_PANEL, tooltip = 'Off: never show it. When empty: only when the indicator has nothing to draw, explaining why - almost always a noise filter calibrated for a different instrument. Always: keep the panel up, showing the live state of the measurement.')
panelPositionName = input.string('Top right', 'Panel position', options = ['Top right', 'Top left', 'Bottom right', 'Bottom left', 'Middle right'], group = GRP_PANEL)
panelTextColor = input.color(color.new(color.gray, 0), 'Panel text color', group = GRP_PANEL)
panelBgColor = input.color(color.new(color.black, 70), 'Panel background', group = GRP_PANEL)

showZigzag = input.bool(false, 'Show zigzag', group = GRP_ZIGZAG, tooltip = 'The swing skeleton the corrections are measured on. Off by default - it is scaffolding, not part of the method.')
zigzagUpColor = input.color(color.new(#26A69A, 40), 'Up leg color', group = GRP_ZIGZAG)
zigzagDownColor = input.color(color.new(#EF5350, 40), 'Down leg color', group = GRP_ZIGZAG)
zigzagWidth = input.int(1, 'Line width', minval = 1, maxval = 4, group = GRP_ZIGZAG)

showSignal = input.bool(true, 'Show break markers', group = GRP_SIGNAL)
signalUpColor = input.color(#26A69A, 'Bullish break color', group = GRP_SIGNAL, tooltip = 'A downtrend broken to the upside.')
signalDownColor = input.color(#EF5350, 'Bearish break color', group = GRP_SIGNAL, tooltip = 'An uptrend broken to the downside.')
showSignalLabel = input.bool(true, 'Label the break', group = GRP_SIGNAL)
labelUnitName = input.string('Points', 'Label unit', options = ['Points', 'Percent'], group = GRP_SIGNAL)
textSizeName = input.string('Small', 'Text size', options = ['Auto', 'Tiny', 'Small', 'Normal', 'Large'], group = GRP_SIGNAL)

textSize = switch textSizeName
    'Auto' => size.auto
    'Tiny' => size.tiny
    'Normal' => size.normal
    'Large' => size.large
    => size.small

// The noise filter in price units. ATR keeps it proportional to the volatility
// of whatever instrument the script runs on.
atr = ta.atr(14)
noiseFloor = switch noiseUnitName
    'Percent' => close * minCorrection / 100
    'ATR' => atr * minCorrection
    => minCorrection

// Confirmed swings. ta.pivothigh returns the pivot price rightBars after the
// pivot bar, so every swing lands at bar_index - rightBars.
pivotHigh = ta.pivothigh(high, leftBars, rightBars)
pivotLow = ta.pivotlow(low, leftBars, rightBars)

// Last confirmed swing.
var float lastSwingPrice = na
var int lastSwingBar = na

// The overbalance itself - the largest correction of the running trend. Its
// two edges are the rectangle, and the range between them drives everything:
// the entry, the tolerance, the stop.
var float obNear = na
var float obFar = na
var int obStartBar = na
var box obBox = na

// The extreme of the running trend - the target the method aims at.
var float trendExtreme = na
var int trendExtremeBar = na

// Trend direction: 1 up, -1 down, 0 unknown.
var int trend = 0

// Diagnostics: what the measurement rejected and why. The largest rejected
// correction is the single most telling number - when it sits just under the
// filter, the filter is calibrated for a different instrument.
// After a break the indicator must see a genuinely new structure before it
// defines a trend again - otherwise the very leg that broke the setup defines
// the next one, rebuilding it in the same place and breaking it again.
var int swingsSinceBreak = 99

var int swingCount = 0
var int rejectedCount = 0
var float largestRejected = na
var int obUpdates = 0
var int breakCount = 0

var line entryLine = na
var line stopLine = na
var line targetLine = na
var label entryLabel = na

fmtSize(float priceRange, float basePrice) =>
    labelUnitName == 'Percent' and basePrice != 0 ? str.tostring(priceRange / basePrice * 100, '0.00') + '%' : str.tostring(priceRange, format.mintick)

// Registering a confirmed swing happens in global scope - Pine forbids
// assigning to global variables inside a user-defined function. Both pivots
// can confirm on the same bar, so the block runs once per pivot type.
float swingPrice = na
bool swingIsHigh = false
for pass = 0 to 1
    swingPrice := pass == 0 ? pivotHigh : pivotLow
    swingIsHigh := pass == 0

    if not na(swingPrice)
        swingBar = bar_index - rightBars

        swingCount := swingCount + 1
        swingsSinceBreak := swingsSinceBreak + 1

        if not na(lastSwingPrice)
            if showZigzag
                line.new(lastSwingBar, lastSwingPrice, swingBar, swingPrice, xloc = xloc.bar_index, color = swingIsHigh ? zigzagUpColor : zigzagDownColor, width = zigzagWidth)

            legRange = math.abs(swingPrice - lastSwingPrice)

            // A correction runs against the trend: inside an uptrend the
            // high -> low leg, inside a downtrend the low -> high one. Only
            // corrections are ever compared - never an impulse to a correction.
            isCorrection = (trend == 1 and not swingIsHigh) or (trend == -1 and swingIsHigh)

            // Every leg that fails the filter is worth counting - it is the
            // evidence that tells a badly calibrated filter from a quiet market.
            if legRange < noiseFloor
                rejectedCount := rejectedCount + 1
                if na(largestRejected) or legRange > largestRejected
                    largestRejected := legRange

            if trend == 0
                // Two fresh swings must land before a direction is accepted,
                // so the breaking leg itself cannot seed the next trend.
                if legRange >= noiseFloor and swingsSinceBreak >= 2
                    trend := swingIsHigh ? 1 : -1
                    trendExtreme := swingPrice
                    trendExtremeBar := swingBar
            else if isCorrection and legRange >= noiseFloor
                // A correction worth measuring. Whether it replaces the
                // current rectangle depends on the reference mode: the first
                // correction is kept for the life of the trend, the largest
                // one is replaced only by a bigger one, the last one always
                // wins.
                currentOb = na(obNear) or na(obFar) ? na : math.abs(obNear - obFar)
                takeIt = switch referenceName
                    'First correction' => na(currentOb)
                    'Last correction' => true
                    => na(currentOb) or legRange > currentOb

                if takeIt
                    obUpdates := obUpdates + 1
                    obNear := lastSwingPrice
                    obFar := swingPrice
                    obStartBar := lastSwingBar

                    // A fresh rectangle replaces the previous one; the old
                    // rectangle is either frozen where it stood or removed.
                    if not na(obBox)
                        if showHistory
                            box.set_right(obBox, swingBar)
                            box.set_bgcolor(obBox, color.new(color.gray, 92))
                            box.set_border_color(obBox, color.new(color.gray, 70))
                        else
                            box.delete(obBox)
                    obBox := showRect ? box.new(lastSwingBar, math.max(lastSwingPrice, swingPrice), swingBar, math.min(lastSwingPrice, swingPrice), xloc = xloc.bar_index, bgcolor = trend == 1 ? rectUpColor : rectDownColor, border_color = rectBorderColor, border_width = 2) : na
            else if not isCorrection
                // An impulse leg - it may push the trend extreme further out.
                if trend == 1 and swingIsHigh and (na(trendExtreme) or swingPrice > trendExtreme)
                    trendExtreme := swingPrice
                    trendExtremeBar := swingBar
                if trend == -1 and not swingIsHigh and (na(trendExtreme) or swingPrice < trendExtreme)
                    trendExtreme := swingPrice
                    trendExtremeBar := swingBar

        lastSwingPrice := swingPrice
        lastSwingBar := swingBar

// Price runs ahead of the confirmed swings, so the trend extreme - the target -
// tracks it bar by bar.
if trend == 1 and not na(trendExtreme) and high > trendExtreme
    trendExtreme := high
    trendExtremeBar := bar_index
if trend == -1 and not na(trendExtreme) and low < trendExtreme
    trendExtreme := low
    trendExtremeBar := bar_index

// The trade levels. Entry sits at the far edge of the rectangle - the price
// the method joins the trend at. Stop sits one tolerance past it, and that is
// also the level that permanently breaks the trend.
obRange = na(obNear) or na(obFar) ? na : math.abs(obNear - obFar)
entry = na(obRange) or trend == 0 ? na : obFar
stop = na(entry) ? na : trend == 1 ? entry - obRange * tolerancePct / 100 : entry + obRange * tolerancePct / 100

// The break. A wick through the stop is enough by default, matching a resting
// stop order; 'Break on close only' waits for the bar to close beyond it.
breakPrice = useCloseForBreak ? close : trend == 1 ? low : high
broken = not na(stop) and (trend == 1 ? breakPrice <= stop : breakPrice >= stop)

if broken
    breakCount := breakCount + 1
    bullish = trend == -1
    col = bullish ? signalUpColor : signalDownColor

    if showSignal
        label.new(bar_index, stop, '', xloc = xloc.bar_index, style = bullish ? label.style_triangleup : label.style_triangledown, color = col, size = size.small)

    if showSignalLabel
        label.new(bar_index, stop, (bullish ? 'OB ▲ ' : 'OB ▼ ') + fmtSize(obRange, stop), xloc = xloc.bar_index, style = bullish ? label.style_label_up : label.style_label_down, color = color.new(color.black, 100), textcolor = col, size = textSize)

    // Freeze the rectangle of the trend that just died.
    if not na(obBox)
        if showHistory
            box.set_right(obBox, bar_index)
            box.set_bgcolor(obBox, color.new(color.gray, 92))
            box.set_border_color(obBox, color.new(color.gray, 70))
        else
            box.delete(obBox)
        obBox := na

    obNear := na
    obFar := na
    obStartBar := na

    swingsSinceBreak := 0

    if flipOnBreak
        trend := -trend
        trendExtreme := trend == 1 ? high : low
        trendExtremeBar := bar_index
    else
        trend := 0
        trendExtreme := na
        trendExtremeBar := na

alertcondition(broken, 'Overbalance broken', 'Overbalance permanently broken - the trend is no longer valid')

// The live picture, redrawn on the last bar: the rectangle stretched to the
// right plus the three trade levels it implies.
if barstate.islast
    if not na(obBox) and not na(obStartBar)
        box.set_right(obBox, bar_index + rectExtend)

    if not na(entryLine)
        line.delete(entryLine)
    if not na(stopLine)
        line.delete(stopLine)
    if not na(targetLine)
        line.delete(targetLine)
    if not na(entryLabel)
        label.delete(entryLabel)
    entryLine := na
    stopLine := na
    targetLine := na
    entryLabel := na

    if not na(entry) and not na(obStartBar)
        right = bar_index + levelExtend
        // xloc.bar_index reaches at most ~10000 bars back, and an overbalance
        // that survived a long trend can sit further than that - clamp the
        // left end instead of letting the drawing fail at runtime (RE10026).
        left = math.max(obStartBar, bar_index - MAX_BARS_BACK)

        if showEntry
            entryLine := line.new(left, entry, right, entry, xloc = xloc.bar_index, color = entryColor, style = line.style_solid, width = 2)
        if showStop
            stopLine := line.new(left, stop, right, stop, xloc = xloc.bar_index, color = stopColor, style = line.style_dashed)
        if showTarget and not na(trendExtreme)
            targetLine := line.new(left, trendExtreme, right, trendExtreme, xloc = xloc.bar_index, color = targetColor, style = line.style_dotted)

        if showRR and showEntry and not na(trendExtreme)
            risk = math.abs(entry - stop)
            reward = math.abs(trendExtreme - entry)
            rr = risk > 0 ? reward / risk : na
            txt = 'Entry ' + str.tostring(entry, format.mintick) + (na(rr) ? '' : '  R:R 1:' + str.tostring(rr, '0.0'))
            entryLabel := label.new(right, entry, txt, xloc = xloc.bar_index, style = label.style_label_left, color = color.new(color.black, 100), textcolor = entryColor, size = textSize)

// An indicator that silently draws nothing is indistinguishable from a broken
// one. The panel reports what the measurement is doing: how many swings it
// saw, how many corrections the noise filter rejected and - the telling one -
// how large the largest rejected correction was. A filter calibrated for
// another instrument shows up immediately as "rejected 40, largest 2.1"
// against a filter of 40.
panelPosition = switch panelPositionName
    'Top left' => position.top_left
    'Bottom right' => position.bottom_right
    'Bottom left' => position.bottom_left
    'Middle right' => position.middle_right
    => position.top_right

panelWanted = panelModeName == 'Always' or (panelModeName == 'When empty' and na(obNear))

if barstate.islast and panelWanted
    var table panel = table.new(panelPosition, 2, 10, border_width = 1)
    table.clear(panel, 0, 0, 1, 9)

    trendText = trend == 1 ? 'up' : trend == -1 ? 'down' : 'undefined'
    obText = na(obNear) or na(obFar) ? '-' : str.tostring(math.abs(obNear - obFar), format.mintick)
    entryText = na(entry) ? '-' : str.tostring(entry, format.mintick)
    stopText = na(stop) ? '-' : str.tostring(stop, format.mintick)
    targetText = na(trendExtreme) ? '-' : str.tostring(trendExtreme, format.mintick)
    rejectedText = str.tostring(rejectedCount) + (na(largestRejected) ? '' : ' (max ' + str.tostring(largestRejected, format.mintick) + ')')

    table.cell(panel, 0, 0, 'Overbalance', text_color = panelTextColor, text_size = size.small, text_halign = text.align_left, bgcolor = panelBgColor)
    table.cell(panel, 1, 0, 'diagnostics', text_color = panelTextColor, text_size = size.small, text_halign = text.align_right, bgcolor = panelBgColor)
    table.cell(panel, 0, 1, 'Trend', text_color = panelTextColor, text_size = size.small, text_halign = text.align_left, bgcolor = panelBgColor)
    table.cell(panel, 1, 1, trendText, text_color = panelTextColor, text_size = size.small, text_halign = text.align_right, bgcolor = panelBgColor)
    table.cell(panel, 0, 2, 'Reference', text_color = panelTextColor, text_size = size.small, text_halign = text.align_left, bgcolor = panelBgColor)
    table.cell(panel, 1, 2, referenceName, text_color = panelTextColor, text_size = size.small, text_halign = text.align_right, bgcolor = panelBgColor)
    table.cell(panel, 0, 3, 'Filter', text_color = panelTextColor, text_size = size.small, text_halign = text.align_left, bgcolor = panelBgColor)
    table.cell(panel, 1, 3, str.tostring(noiseFloor, format.mintick) + '  [' + str.tostring(minCorrection) + ' ' + noiseUnitName + ']', text_color = panelTextColor, text_size = size.small, text_halign = text.align_right, bgcolor = panelBgColor)
    table.cell(panel, 0, 4, 'Swings seen', text_color = panelTextColor, text_size = size.small, text_halign = text.align_left, bgcolor = panelBgColor)
    table.cell(panel, 1, 4, str.tostring(swingCount), text_color = panelTextColor, text_size = size.small, text_halign = text.align_right, bgcolor = panelBgColor)
    table.cell(panel, 0, 5, 'Legs rejected', text_color = panelTextColor, text_size = size.small, text_halign = text.align_left, bgcolor = panelBgColor)
    table.cell(panel, 1, 5, rejectedText, text_color = panelTextColor, text_size = size.small, text_halign = text.align_right, bgcolor = panelBgColor)
    table.cell(panel, 0, 6, 'Overbalance', text_color = panelTextColor, text_size = size.small, text_halign = text.align_left, bgcolor = panelBgColor)
    table.cell(panel, 1, 6, obText + (obUpdates > 0 ? '  (' + str.tostring(obUpdates) + '×)' : ''), text_color = panelTextColor, text_size = size.small, text_halign = text.align_right, bgcolor = panelBgColor)
    table.cell(panel, 0, 7, 'Entry / Stop', text_color = panelTextColor, text_size = size.small, text_halign = text.align_left, bgcolor = panelBgColor)
    table.cell(panel, 1, 7, entryText + ' / ' + stopText, text_color = panelTextColor, text_size = size.small, text_halign = text.align_right, bgcolor = panelBgColor)
    table.cell(panel, 0, 8, 'Breaks / Target', text_color = panelTextColor, text_size = size.small, text_halign = text.align_left, bgcolor = panelBgColor)
    table.cell(panel, 1, 8, str.tostring(breakCount) + ' / ' + targetText, text_color = panelTextColor, text_size = size.small, text_halign = text.align_right, bgcolor = panelBgColor)

    // The bottom row carries the verdict - what to do about an empty chart.
    verdict = not na(obNear) ? 'measuring' : swingCount < 2 ? 'not enough swings yet - widen the chart history' : swingsSinceBreak < 2 ? 'waiting for a fresh structure after the last break' : breakCount > 20 ? 'breaking far too often - raise the filter or move to a higher timeframe' : rejectedCount > 0 and not na(largestRejected) ? 'filter too large - largest leg was ' + str.tostring(largestRejected, format.mintick) : trend == 0 ? 'no trend defined yet' : 'no correction has qualified yet'
    table.cell(panel, 0, 9, verdict, text_color = panelTextColor, text_size = size.small, text_halign = text.align_left, bgcolor = panelBgColor)
    table.merge_cells(panel, 0, 9, 1, 9)
